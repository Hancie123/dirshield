{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DirShield",
  "version": "1.1.2",
  "identifier": "com.dirshield.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DirShield",
        "width": 480,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "transparent": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Mero Vision Pvt. Ltd",
    "copyright": "© 2026 Mero Vision Pvt. Ltd",
    "category": "Utility",
    "shortDescription": "Folder locker with Quick Lock and AES-256-GCM Secure Lock",
    "longDescription": "DirShield protects folders on Windows with Quick Lock (hide and restrict access) and Secure Lock (AES-256-GCM encryption with Argon2id-protected keys).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMzY0Njc1MkUzNEU2NUIKUldSYjVqUXVkVVkyRVRTUFUrV1NzRmFkbnlqd3NPS0RMU05pKzc4bTM4MjNQUWFaWk5tbytIRW4K",
      "endpoints": [
        "https://github.com/Hancie123/dirshield/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
