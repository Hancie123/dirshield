{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DirShield",
  "version": "1.0.0",
  "identifier": "com.dirshield.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DirShield",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "transparent": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DirShield",
    "copyright": "DirShield",
    "category": "Utility",
    "shortDescription": "Folder locker with Quick Lock and AES-256-GCM Secure Lock",
    "longDescription": "DirShield protects folders on Windows with Quick Lock (hide and restrict access) and Secure Lock (AES-256-GCM encryption with Argon2id-protected keys).",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
